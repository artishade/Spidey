{
  "manifest_version": 3,
  "name": "Gem Search — The Narrative Spider",
  "version": "0.4.0",
  "description": "A standalone spider that explores visible X posts, collects evidence and reviews research leads with your own AI provider.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Release your research spider"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}